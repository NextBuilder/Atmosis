# Atmosis — paste your own keys below, replacing the text after each = sign.
# While a placeholder is left in place, that feature stays switched off.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_API_KEY

# Telegram bot token — in Telegram, message @BotFather and send /newbot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Your Telegram chat ID — in Telegram, message @userinfobot
TELEGRAM_CHAT_ID=PASTE_HERE
